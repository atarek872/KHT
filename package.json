{
  "name": "kht-storefront",
  "private": true,
  "type": "module",
  "scripts": {
    "images:optimize": "node scripts/optimize-images.mjs",
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "build:cloudflare": "nuxt build --preset cloudflare_module && node scripts/stage-sites.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "format": "prettier --write app server shared tests scripts nuxt.config.ts package.json tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "nuxt": "4.5.2",
    "vue": "^3.5.0",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.1.0"
  }
}
